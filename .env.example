# ==============================================================================
# Vercel Environment Variables Template
# ==============================================================================
# Copy this file to .env.local for local development, or import these variables 
# directly into your Vercel Dashboard under Settings > Environment Variables.

# 1. Prisma / Vercel Postgres Database Connection
# ------------------------------------------------------------------------------
# Replace these with the actual connection strings provided in the Storage tab 
# of your Vercel project dashboard when you create a Vercel Postgres Database.

# A connection string that uses pgBouncer for connection pooling (Required by Prisma for serverless environments)
POSTGRES_PRISMA_URL="postgres://default:YOUR_PASSWORD@ep-nameless-lake-123456.us-east-1.postgres.vercel-storage.com:5432/verceldb?pgbouncer=true&connect_timeout=15"

# A direct connection string with no pooling (Required by Prisma for database migrations)
POSTGRES_URL_NON_POOLING="postgres://default:YOUR_PASSWORD@ep-nameless-lake-123456.us-east-1.postgres.vercel-storage.com:5432/verceldb"


# 2. Supabase Configuration (If still using Supabase for Storage / Auth alongside Postgres)
# ------------------------------------------------------------------------------
# If you are keeping Supabase for real-time channels or other features, keep these here.
NEXT_PUBLIC_SUPABASE_URL="https://iqxeglbbvseirtjbwtdu.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_5fFaz9BHk_oxp_LyBH9e4A_8JtEIErr"
